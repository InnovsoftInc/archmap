{
  "archmap": "__VERSION__",
  "name": "__NAME__",
  "base": "__BASE__",
  "upgrade": "auto",
  "agent": {
    "command": "claude -p --permission-mode acceptEdits --allowedTools \"Bash({cli} check:*)\" \"Bash({cli} brief:*)\"",
    "skip": [
      "**/*.test.*",
      "**/__tests__/**",
      "**/*.md",
      "**/*.lock",
      "**/pnpm-lock.yaml",
      "**/package-lock.json"
    ]
  },
  "ignore": []
}
